# ── Core (required — the app refuses to start without these) ──────────────────
MONGODB_URI=mongodb://localhost:27017/sagewell
JWTSECRET_KEY=change-me-to-a-long-random-string
# Gemini powers the chat/agent models and the embeddings.
GEMINI_API_KEY=
# Optional overrides for the Gemini models (defaults shown):
# GEMINI_MODEL_MAIN=gemini-3.8-flash
# GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Google sign-in ────────────────────────────────────────────────────────────
# OAuth Client ID from Google Cloud Console (type: Web application). Public value, no secret needed.
GOOGLE_CLIENT_ID=

# ── Web scraping (optional) ───────────────────────────────────────────────────
# Context.dev key (https://www.context.dev/dashboard/api-keys). If set, web links are scraped with
# Context.dev (renders JavaScript); if unset or it fails, the free local reader is used.
CONTEXT_DEV_API_KEY=

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
QUADRANT_URL=http://localhost:6333
QUADRANT_API_KEY=

# ── Object storage (S3 / Cloudflare R2) ───────────────────────────────────────
# Cloudflare R2: leave S3_REGION empty. AWS S3: set S3_REGION (e.g. ap-south-1) and leave S3_API empty.
S3_REGION=
S3_API=https://<account>.r2.cloudflarestorage.com
S3_Access_Key_ID=
S3_Secret_Access_Key=
S3_BUCKET=sagewell

# ── Redis (BullMQ queues) ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Neo4j (long-term memory graph) ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
# Optional: email that is granted admin (observability dashboard) access.
ADMIN_EMAIL=

# ── Deployment only (not needed locally) ──────────────────────────────────────
# Comma-separated list of website URLs allowed to call this API (CORS).
# CLIENT_ORIGINS=https://app.yourdomain.com
# Used by the docker-compose files: public API address, log viewer address, and the
# email Let's Encrypt uses for HTTPS certificates.
# API_DOMAIN=api.yourdomain.com
# LOGS_DOMAIN=logs.yourdomain.com
# ACME_EMAIL=you@yourdomain.com
