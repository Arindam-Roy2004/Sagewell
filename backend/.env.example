# ── Core (required — the app refuses to start without these) ──────────────────
MONGODB_URI=mongodb://localhost:27017/sagewell
JWTSECRET_KEY=change-me-to-a-long-random-string
# OpenRouter powers the chat/agent models and the embeddings.
OPENROUTER_API_KEY=
# Optional overrides for the OpenRouter models (defaults shown):
# LLM_MODEL_MAIN=deepseek/deepseek-v4-flash
# LLM_MODEL_LIGHT=deepseek/deepseek-v4-flash
# EMBEDDING_MODEL=google/gemini-embedding-001
# Reasoning for the final chat answer (off|low|medium|high). Adds a few seconds per answer.
# LLM_REASONING_ANSWER=off
# Highest provider price accepted per 1M tokens (USD); credits are billed at this cap.
# LLM_MAX_PRICE_INPUT=0.2
# LLM_MAX_PRICE_OUTPUT=0.6

# ── Google sign-in ────────────────────────────────────────────────────────────
# OAuth Client ID from Google Cloud Console (type: Web application). Public value, no secret needed.
GOOGLE_CLIENT_ID=

# ── Web scraping (optional) ───────────────────────────────────────────────────
# Context.dev key (https://www.context.dev/dashboard/api-keys). If set, web links are scraped with
# Context.dev (renders JavaScript); if unset or it fails, the free local reader is used.
CONTEXT_DEV_API_KEY=

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
QUADRANT_URL=http://localhost:6333
QUADRANT_API_KEY=

# ── Object storage (S3 / Cloudflare R2) ───────────────────────────────────────
# Cloudflare R2: leave S3_REGION empty. AWS S3: set S3_REGION (e.g. ap-south-1) and leave S3_API empty.
S3_REGION=
S3_API=https://<account>.r2.cloudflarestorage.com
S3_Access_Key_ID=
S3_Secret_Access_Key=
S3_BUCKET=sagewell

# ── Redis (BullMQ queues) ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Neo4j (long-term memory graph) ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
# Optional: email that is granted admin (observability dashboard) access.
ADMIN_EMAIL=

# ── Deployment only (not needed locally) ──────────────────────────────────────
# Comma-separated list of website URLs allowed to call this API (CORS).
# CLIENT_ORIGINS=https://app.yourdomain.com
# Used by the docker-compose files: public API address, log viewer address, and the
# email Let's Encrypt uses for HTTPS certificates.
# API_DOMAIN=api.yourdomain.com
# LOGS_DOMAIN=logs.yourdomain.com
# ACME_EMAIL=you@yourdomain.com

# ── Credits (all optional; defaults shown) ─────────────────────────────────────
# Every account starts with CREDITS_STARTING credits. 1 credit = CREDIT_MICROS micro-USD ($0.001).
# CREDITS_STARTING=100
# CREDIT_MICROS=1000
# CREDITS_MARKUP=1.2          # safety multiplier on measured model cost
# CREDITS_CHAT_RESERVE=8      # held per answer, unused part returned
# CREDITS_CHAT_MINIMUM=2      # smallest balance that can still ask a question
# CREDITS_CHAT_OVERHEAD=0.5   # background work per answer (summaries, memory)
# CREDITS_FILE_RESERVE=5      # held per upload until its real size is known
# CREDITS_LINK_FLAT=3         # extra fee for a web link
# MAX_URL_SOURCES=1           # web links per account
# MAX_FILE_MB=20
# MAX_PASTED_CHARS=100000
# MAX_SOURCE_CHARS=500000     # extracted text per source
# MAX_MESSAGE_CHARS=4000
