# API base URL. Defaults to http://localhost:8080/api/v1 in dev if unset.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google sign-in: same Client ID as GOOGLE_CLIENT_ID in backend/.env. The Google button is hidden if unset.
VITE_GOOGLE_CLIENT_ID=

# Optional: show the admin dashboard link for this email (match ADMIN_EMAIL in backend/.env).
# VITE_ADMIN_EMAIL=
