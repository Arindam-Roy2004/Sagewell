# Copy to /root/app/sagewell/.env on the VPS (chmod 600). Never commit the real file.
# The deploy sets NODE_ENV, PORT (API) and REDIS_HOST itself with `docker run -e`.
# Neo4j is intentionally omitted: the memory graph is simply skipped when unset.
# Values are read as-is by `docker run --env-file` (no quotes, no inline comments).

# Required
MONGODB_URI=
# Generate with: openssl rand -hex 48
JWTSECRET_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Qdrant Cloud
QUADRANT_URL=
QUADRANT_API_KEY=

# Cloudflare R2
S3_REGION=
S3_API=
S3_Access_Key_ID=
S3_Secret_Access_Key=
S3_BUCKET=sagewell

# CORS: the Vercel site(s) allowed to call this API, comma-separated
CLIENT_ORIGINS=https://sagewell.royarindam.page

# Optional
LOG_LEVEL=info
ADMIN_EMAIL=
CONTEXT_DEV_API_KEY=
